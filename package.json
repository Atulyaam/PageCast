    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
