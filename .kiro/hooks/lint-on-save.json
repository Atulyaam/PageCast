{
  "version": "v1",
  "hooks": [
    {
      "name": "Lint on Save",
      "description": "Automatically run ESLint on TypeScript and TSX files upon save",
      "trigger": "PostFileSave",
      "matcher": "^src/.*\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "pnpm eslint ${file}"
      },
      "timeout": 30
    }
  ]
}
